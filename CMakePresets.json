{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "RelWithDebInfo (default)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ROCKETLAB_BUILD_TESTS": "ON",
        "ROCKETLAB_BUILD_TUI": "ON",
        "ROCKETLAB_BUILD_GUI": "ON",
        "ROCKETLAB_WERROR": "ON"
      }
    },
    {
      "name": "dev-headless",
      "inherits": "dev",
      "displayName": "RelWithDebInfo without the clients",
      "binaryDir": "${sourceDir}/build/dev-headless",
      "cacheVariables": {
        "ROCKETLAB_BUILD_TUI": "OFF",
        "ROCKETLAB_BUILD_GUI": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "dev", "configurePreset": "dev" },
    { "name": "dev-headless", "configurePreset": "dev-headless" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true }
    }
  ]
}
